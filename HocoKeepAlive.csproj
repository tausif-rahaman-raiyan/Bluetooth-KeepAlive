<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets\hoco-keepalive.ico</ApplicationIcon>
    <AssemblyName>Keep Alive</AssemblyName>
    <RootNamespace>HocoKeepAlive</RootNamespace>
    <Version>1.0.5</Version>
    <FileVersion>1.0.5.0</FileVersion>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <Description>Silent Bluetooth audio keep-alive utility</Description>
    <Company>Raiyan</Company>
    <Product>Keep Alive</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;node_modules\**;dist\**;web\**;wwwroot\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test sources and web sources must be excluded from application compilation -->
    <Compile Remove="tests\**" />
    <Compile Remove="web\**" />
  </ItemGroup>

  <!-- Built React UI (npm run build -> dist) is shipped next to the exe as wwwroot -->
  <ItemGroup Condition="Exists('dist\index.html')">
    <Content Include="dist\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\hoco-keepalive.ico" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>
</Project>