From d237ca9c453f6a0d219489de1653d546dcb3d936 Mon Sep 17 00:00:00 2001
From: Claude <claude@example.com>
Date: Fri, 30 Oct 2026 06:17:45 +0000
Subject: [PATCH] Render the React dashboard UI inside the Windows app via
 WebView2

- Add WebMainForm (WebView2 host) + JSON bridge to the audio engine
- Add web/host.ts bridge; App.tsx uses real device/battery/settings state when hosted
- Build web bundle in CI and ship it as wwwroot; fall back to WinForms UI if WebView2 is missing
---
 .github/workflows/build.yml |   13 +
 HocoKeepAlive.csproj        |    8 +-
 package-lock.json           | 2482 +++++++++++++++++++++++++++++++++++
 src/UI/KeepAliveContext.cs  |   30 +-
 src/UI/WebMainForm.cs       |  533 ++++++++
 vite.config.ts              |    7 +
 web/App.tsx                 |  199 ++-
 web/host.ts                 |   88 ++
 8 files changed, 3331 insertions(+), 29 deletions(-)
 create mode 100644 package-lock.json
 create mode 100644 src/UI/WebMainForm.cs
 create mode 100644 web/host.ts

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index bf6bc66..ae793f4 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -63,6 +63,16 @@ jobs:
           Write-Host "Determined Application Build Version: $ver"
           "APP_VER=$ver" | Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
 
+      - name: 4b. Build React dashboard UI (WebView2 bundle)
+        shell: pwsh
+        run: |
+          npm ci
+          npm run build
+          if (!(Test-Path "dist/index.html")) {
+            throw "Web UI build failed: dist/index.html not found."
+          }
+          Write-Host "Web UI bundle ready: $((Get-ChildItem dist -Recurse -File | Measure-Object).Count) files."
+
       - name: 5. Generate multi-resolution icon
         shell: pwsh
         run: |
@@ -111,6 +121,9 @@ jobs:
           if (!(Test-Path $exe)) {
             throw "Application executable not found at $exe."
           }
+          if (!(Test-Path "publish/wwwroot/index.html")) {
+            throw "Web UI bundle missing from publish output (publish/wwwroot/index.html)."
+          }
           Write-Host "Published binary validated at $exe ($((Get-Item $exe).Length) bytes)."
 
       - name: 9. Install Inno Setup compiler
diff --git a/HocoKeepAlive.csproj b/HocoKeepAlive.csproj
index 2792322..792ee17 100644
--- a/HocoKeepAlive.csproj
+++ b/HocoKeepAlive.csproj
@@ -18,7 +18,7 @@
     <ApplicationVisualStyles>true</ApplicationVisualStyles>
     <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
     <ApplicationManifest>app.manifest</ApplicationManifest>
-    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;node_modules\**;dist\**;web\**</DefaultItemExcludes>
+    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;node_modules\**;dist\**;web\**;wwwroot\**</DefaultItemExcludes>
   </PropertyGroup>
 
   <ItemGroup>
@@ -27,8 +27,14 @@
     <Compile Remove="web\**" />
   </ItemGroup>
 
+  <!-- Built React UI (npm run build -> dist) is shipped next to the exe as wwwroot -->
+  <ItemGroup Condition="Exists('dist\index.html')">
+    <Content Include="dist\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
+  </ItemGroup>
+
   <ItemGroup>
     <EmbeddedResource Include="assets\hoco-keepalive.ico" />
     <PackageReference Include="NAudio" Version="2.2.1" />
+    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
   </ItemGroup>
 </Project>
\ No newline at end of file
